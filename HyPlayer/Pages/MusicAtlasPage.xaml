<Page
    x:Class="HyPlayer.Pages.MusicAtlasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="24,12">
            <Button Content="返回歌单" Click="Back_Click" />
            <TextBlock x:Name="Status" Text="正在加载完整歌单…" VerticalAlignment="Center" />
            <Button x:Name="Retry" Content="重试" Visibility="Collapsed" Click="Retry_Click" />
        </StackPanel>
        <controls:WebView2 x:Name="Atlas" Grid.Row="1" Loaded="Atlas_Loaded" />
    </Grid>
</Page>
